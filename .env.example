# Desktop Starter App - Environment Variables
#
# This file is for SECRETS ONLY. Do not commit actual values to version control.
# Copy this file to .env for local development.
#
# App configuration (non-secrets) is in app.config.ts

# ============================================================================
# GITHUB
# ============================================================================

# No token is needed or read. Auto-updates come from a public GitHub repo and
# nothing credential-like is ever baked into the app (see forge.config.ts).

# ============================================================================
# MACOS CODE SIGNING (for production releases)
# These should be set as GitHub Secrets, not in .env
# ============================================================================

# Apple Developer ID email
# APPLE_ID=your@apple.id

# App-specific password (generate at appleid.apple.com)
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Apple Developer Team ID (10-character string)
# APPLE_TEAM_ID=XXXXXXXXXX

# Signing identity (default: "Developer ID Application")
# APPLE_SIGNING_IDENTITY=Developer ID Application
